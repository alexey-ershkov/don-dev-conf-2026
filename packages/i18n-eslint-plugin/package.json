{
  "name": "i18n-eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint plugin for enforcing i18n on user-facing strings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "i18n"
  ],
  "license": "ISC",
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/estree-jsx": "^1.0.5",
    "@types/node": "^25.9.0",
    "eslint": "^10.4.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3"
  }
}
